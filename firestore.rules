rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el administrador (este correo) puede escribir.
    function esAdmin() {
      return request.auth != null && request.auth.token.email == "canirac@caniraclaguna.mx";
    }

    // Solicitud pendiente dentro de los 15 días de prueba.
    // (inicioPrueba lo pone el SERVIDOR; las solicitudes anteriores usan createdAt.)
    function enPrueba(d) {
      return d.estado == "pendiente" && (
        ("inicioPrueba" in d && request.time < d.inicioPrueba + duration.value(15, "d"))
        || (!("inicioPrueba" in d) && d.createdAt is number
            && request.time.toMillis() < d.createdAt + 15 * 86400000)
      );
    }

    // Puede ver el catálogo: acceso CONFIRMADO en el panel ("Autorizaciones de
    // acceso") o periodo de prueba vigente mientras el admin decide.
    function tieneAcceso() {
      let ruta = /databases/$(database)/documents/accesos/$(request.auth.uid);
      return request.auth != null && exists(ruta)
        && (get(ruta).data.estado == "aprobado" || enPrueba(get(ruta).data));
    }

    // Correo real: verificado, o cuenta vinculada a Google.
    function correoVerificado() {
      return request.auth.token.email_verified == true
        || "google.com" in request.auth.token.firebase.identities;
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Contenido del catálogo: proveedores y configuración del inicio.
    // Lo LEEN las personas autorizadas o en prueba (y el admin). Solo el admin ESCRIBE.
    match /content/{doc} {
      allow read: if esAdmin() || tieneAcceso();
      allow write: if esAdmin();
    }

    // Solicitudes de acceso al catálogo (una por cuenta, id = uid).
    // - La persona crea SU solicitud, siempre como "pendiente", con su correo
    //   de Google. No puede cambiarla, aprobarse ni alargar su prueba.
    // - Solo el administrador la confirma, la deniega o la elimina.
    match /accesos/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && correoVerificado()
        && request.resource.data.keys().hasOnly(["uid", "email", "nombre", "fechaNacimiento", "restaurante", "puesto", "foto", "estado", "createdAt", "inicioPrueba"])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.estado == "pendiente"
        && request.resource.data.inicioPrueba == request.time
        && texto(request.resource.data.nombre, 3, 120)
        && texto(request.resource.data.fechaNacimiento, 10, 10)
        && texto(request.resource.data.restaurante, 2, 120)
        && texto(request.resource.data.puesto, 2, 80)
        && texto(request.resource.data.foto, 0, 600)
        && request.resource.data.createdAt is number;
      allow update, delete: if esAdmin();
    }

    // Solicitudes "¿Eres proveedor? Regístrate aquí" (desde el catálogo).
    // Las envía una persona con sesión. Solo el administrador las VE/BORRA.
    match /equipo/{doc} {
      allow create: if request.auth != null
        && texto(request.resource.data.nombre, 1, 120)
        && texto(request.resource.data.telefono, 1, 40)
        && texto(request.resource.data.giro, 1, 120)
        && texto(request.resource.data.mensaje, 0, 2000);
      allow read, update, delete: if esAdmin();
    }

    // Datos privados de cada usuario (favoritos, búsquedas).
    // Cada usuario solo puede leer/escribir SU propio documento.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Dispositivos registrados para avisos push.
    // Un usuario con sesión registra SU dispositivo (crear/actualizar su token).
    // Solo el administrador o la Cloud Function pueden leerlos/borrarlos.
    match /pushTokens/{token} {
      allow create, update: if request.auth != null && request.resource.data.token == token;
      allow read, delete: if esAdmin();
    }

    // Dispositivos del ADMINISTRADOR que reciben el aviso de cada solicitud de
    // acceso nueva (los usa la Cloud Function "avisoSolicitudAcceso").
    match /adminTokens/{token} {
      allow read, write: if esAdmin();
    }
  }
}
