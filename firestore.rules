rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el administrador (este correo) puede escribir.
    function esAdmin() {
      return request.auth != null && request.auth.token.email == "canirac@caniraclaguna.mx";
    }

    // Contenido público: proveedores y configuración del inicio.
    // Cualquiera puede LEER. Solo el administrador puede ESCRIBIR.
    // (Aunque un visitante inicie sesión con Google, NO puede modificar nada.)
    match /content/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Solicitudes "Forma parte del equipo":
    // Cualquiera puede ENVIAR (create). Solo el administrador puede VER/BORRAR.
    match /equipo/{doc} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    // Datos privados de cada visitante que inició sesión (favoritos, búsquedas).
    // Cada usuario solo puede leer/escribir SU propio documento.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
