rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos y videos de los proveedores.
    // Cualquiera puede VER (lectura pública, para el catálogo).
    // Solo el administrador (este correo) puede SUBIR o BORRAR.
    // (Aunque un visitante inicie sesión con Google, NO puede subir archivos.)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "canirac@caniraclaguna.mx";
    }
  }
}
